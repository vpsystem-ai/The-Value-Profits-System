# Kopiér til .env.local og udfyld. Skal også sættes i Vercel:
# Project Settings → Environment Variables

# API-nøgle fra resend.com (påkrævet)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Valgfrit – har fornuftige standardværdier i api/support.js.
# Afsenderdomænet skal være verificeret i Resend.
SUPPORT_TO_EMAIL=asger@valueprofitssystem.dk
SUPPORT_FROM_EMAIL=Support <support@valueprofitssystem.dk>
